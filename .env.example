DOCKERHUB_USER=amiticvega
IMAGE_TAG=0.1.0

# Must be lowercase -- Compose rejects capitals in project names.
COMPOSE_PROJECT_NAME=practice

# Lowercase on purpose: the entrypoint creates this as a QUOTED identifier,
# so capitals would stick and every psql/connection string would need quoting.
POSTGRES_DB=practicedb
POSTGRES_USER=appuser
POSTGRES_PASSWORD=super-secret-change-me
POSTGRES_PORT=5432

# Least-privilege role the backend actually connects as (see db/init/00_roles.sh
# and db/init/03_grants.sh). POSTGRES_USER above stays a superuser, reserved
# for init scripts and manual admin access -- the app never authenticates as it.
# Defined once here; docker-compose.yml passes both values to the db service
# (to create the role) and the backend service (to connect as it).
APP_DB_USER=app_rw
APP_DB_PASSWORD=change-me-too


BACKEND_PORT=3000
NODE_ENV=production
LOG_LEVEL=info

DB_CONNECT_MAX_RETRIES=10
DB_CONNECT_RETRY_DELAY_MS=1000


FRONTEND_API_BASE_URL=/api
FRONTEND_APP_TITLE=Docker Practice Shop

NGINX_HOST_PORT=8080
