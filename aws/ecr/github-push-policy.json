{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "GetAuthTokenIsAccountLevel",
      "Effect": "Allow",
      "Action": "ecr:GetAuthorizationToken",
      "Resource": "*"
    },
    {
      "Sid": "PushOnlyToPracticeRepos",
      "Effect": "Allow",
      "Action": [
        "ecr:BatchCheckLayerAvailability",
        "ecr:InitiateLayerUpload",
        "ecr:UploadLayerPart",
        "ecr:CompleteLayerUpload",
        "ecr:PutImage",
        "ecr:BatchGetImage",
        "ecr:GetDownloadUrlForLayer",
        "ecr:DescribeImages"
      ],
      "Resource": [
        "arn:aws:ecr:us-east-1:213851292053:repository/practice-backend",
        "arn:aws:ecr:us-east-1:213851292053:repository/practice-frontend"
      ]
    }
  ]
}
